# =============================================================================
# Secrets Only — .env File
# =============================================================================
# This file is for SECRETS ONLY (API keys, tokens, credentials).
# All non-secret configuration belongs in config/settings.yaml.
#
# Setting overrides via APP__ prefix (pydantic-settings):
#   APP__LLM__PROVIDER=gemini       → settings.llm.provider
#   APP__RETRIEVAL__ENABLE_RERANKING=true → settings.retrieval.enable_reranking
#   APP__APP__LOG_LEVEL=DEBUG       → settings.app.log_level
#
# Encrypt secrets with: dotenvx set APP__LLM__DASHSCOPE_API_KEY "your-key"
# Run with:             dotenvx run -- uv run uvicorn ...
# =============================================================================

# -----------------------------------------------------------------------------
# Credentials used by selected runtime roles
# -----------------------------------------------------------------------------

# DashScope API key: required for Qwen embeddings and any selected Qwen roles.
# Get your key at: https://dashscope-us.aliyuncs.com/
APP__LLM__DASHSCOPE_API_KEY=your-dashscope-key-here

# Google Gemini API key (when APP__LLM__PROVIDER=gemini or selected as judge)
# Get your key at: https://aistudio.google.com/apikey
APP__LLM__GEMINI_API_KEY=your-gemini-key-here

# OpenRouter API key (when APP__LLM__PROVIDER=litellm or selected as judge)
# Get your key at: https://openrouter.ai/settings/keys
# APP__LLM__OPENROUTER_API_KEY=your-openrouter-key-here

# OpenCode Go API key for the opt-in Pydantic AI adapter or judge.
# Non-secret settings belong in config/settings.yaml under llm:
#   provider: pydantic-ai
#   pydantic_ai_base_url: https://opencode.ai/inference/go/openai/v1
#   pydantic_ai_model: mimo-v2.6-flash
#   pydantic_ai_structured_output_mode: tool  # or native-json-schema
# Existing Qwen embedding roles still require their own DashScope credential.
# Eval generation preflight currently rejects pydantic-ai; this key does not
# enable an eval CLI harness or authorize live calls. Go capabilities are unverified.
# judge_provider: pydantic-ai is opt-in; its default MiMo judge is NOT independent
# of the MiMo generator and cannot satisfy the matched-pilot judge requirement.
# Keep pay-as-you-go spillover and auto-top-up disabled in the Go account.
# APP__LLM__PYDANTIC_AI_API_KEY=your-opencode-go-key-here

# -----------------------------------------------------------------------------
# Cloudflare R2 data sync (optional)
# -----------------------------------------------------------------------------
# Read ONLY by `scripts/manual/r2_sync.py` (a manual tool), not by app settings,
# so these are plain names rather than APP__ overrides. Syncs three sets:
#   corpus/ <-> data/chroma-d11, raw/ <-> data/raw, review/ <-> data/evals/review
# Create the bucket and a bucket-scoped "Object Read & Write" R2 API token in
# the Cloudflare dashboard (R2 -> Manage R2 API Tokens). R2_ENDPOINT is optional;
# when empty it is derived as https://<account_id>.r2.cloudflarestorage.com.
# Never syncs data/evals/cache, rate_limits.db, chat history, logs, or .env.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET=qna-medical-referenced-data
# R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com

# -----------------------------------------------------------------------------
# Experiment Tracking (Optional)
# -----------------------------------------------------------------------------

# Weights & Biases API key
# Get your key at: https://wandb.ai/settings
# APP__WANDB__WANDB_API_KEY=your-wandb-key-here

# -----------------------------------------------------------------------------
# API Authentication (optional only in development)
# -----------------------------------------------------------------------------
# Set caller API keys to enable auth on endpoints. JSON records use the supported
# APP__API__API_KEYS_JSON setting; do not put either form into non-secret config.
# APP__API__API_KEYS=key1,key2,key3
# APP__API__API_KEYS_JSON='[{"id":"operator","key":"replace-me","role":"admin"}]'

# Required outside development. Configure at least 32 random bytes; never reuse a caller API key.
# APP__API__SESSION_SIGNING_SECRET=

# Container deployment explicitly sets APP__APP__ENVIRONMENT=production.
# Non-secret overrides (provider, models, profile, retrieval, storage) use their
# actual APP__... setting names and are sourced from config/settings.yaml by default.
