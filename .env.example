# =============================================================================
# Secrets Only — .env File
# =============================================================================
# This file is for SECRETS ONLY (API keys, tokens, credentials).
# All non-secret configuration belongs in config/settings.yaml.
#
# Setting overrides via APP__ prefix (pydantic-settings):
#   APP__LLM__PROVIDER=gemini       → settings.llm.provider
#   APP__RETRIEVAL__ENABLE_RERANKING=true → settings.retrieval.enable_reranking
#   APP__APP__LOG_LEVEL=DEBUG       → settings.app.log_level
#
# Encrypt secrets with: dotenvx set APP__LLM__DASHSCOPE_API_KEY "your-key"
# Run with:             dotenvx run -- uv run uvicorn ...
# =============================================================================

# -----------------------------------------------------------------------------
# Required: At least one LLM provider API key
# -----------------------------------------------------------------------------

# Alibaba Dashscope API key for Qwen models
# Get your key at: https://dashscope-us.aliyuncs.com/
APP__LLM__DASHSCOPE_API_KEY=your-dashscope-key-here

# Google Gemini API key (when provider=gemini in settings.yaml)
# Get your key at: https://aistudio.google.com/apikey
# APP__LLM__GEMINI_API_KEY=your-gemini-key-here

# OpenRouter API key (when provider=litellm in settings.yaml)
# Get your key at: https://openrouter.ai/settings/keys
# APP__LLM__OPENROUTER_API_KEY=your-openrouter-key-here

# -----------------------------------------------------------------------------
# Experiment Tracking (Optional)
# -----------------------------------------------------------------------------

# Weights & Biases API key
# Get your key at: https://wandb.ai/settings
# APP__WANDB__WANDB_API_KEY=your-wandb-key-here

# -----------------------------------------------------------------------------
# API Authentication (Optional)
# -----------------------------------------------------------------------------
# Set comma-separated API keys to enable auth on endpoints
# APP__API__API_KEYS=key1,key2,key3
