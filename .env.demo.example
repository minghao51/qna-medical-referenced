# Copy to `.env.demo` on the deployment host, chmod 600, and never commit it.
# Docker Compose interpolation also reads this file when passed via --env-file.
#
# Required:
#   DEMO_ORIGIN                 e.g. https://lab.example.com (no trailing slash)
#   REGISTRY                    e.g. ghcr.io/minghao51
#   IMAGE_TAG                   immutable image tag (deploy workflow passes the commit SHA)
#   CLOUDFLARE_TUNNEL_TOKEN     tunnel token from Cloudflare Zero Trust
#   OPERATOR_API_KEY            plaintext key injected only by the Caddy ingress
#   APP__API__API_KEYS_JSON     bcrypt-hashed record(s) that include OPERATOR_API_KEY
#   APP__API__SESSION_SIGNING_SECRET  independent random secret, >=32 bytes

DEMO_ORIGIN=https://lab.example.com
REGISTRY=ghcr.io/minghao51
IMAGE_TAG=latest

CLOUDFLARE_TUNNEL_TOKEN=
OPERATOR_API_KEY=

# Generate a record with:
#   uv run python -c 'from src.app.security import generate_api_key_record; \
#     import json; print(json.dumps([generate_api_key_record("ingress", "PLAINTEXT", owner="gateway", role="operator")]))'
# Keep this file and the plaintext OPERATOR_API_KEY out of git, logs and screenshots.
APP__API__API_KEYS_JSON=[]
APP__API__SESSION_SIGNING_SECRET=

# Edge rate limiting is required: every visitor shares this one injected key, so
# the backend sees a single authenticated principal. Keep the app limiters on.
APP__API__RATE_LIMIT_PER_MINUTE=30
APP__API__ANONYMOUS_CHAT_RATE_LIMIT_PER_MINUTE=5
APP__API__RATE_LIMIT_BYPASS_KEY_IDS=
APP__API__RATE_LIMIT_BYPASS_ROLES=

APP__LLM__PROVIDER=gemini
APP__LLM__MODEL_NAME=qwen3.5-flash
APP__LLM__GEMINI_MODEL_NAME=gemma-4-31b-it
APP__LLM__EMBEDDING_MODEL=text-embedding-v4
APP__LLM__QWEN_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
APP__LLM__DASHSCOPE_API_KEY=
APP__LLM__GEMINI_API_KEY=
APP__LLM__OPENROUTER_API_KEY=

APP__STORAGE__COLLECTION_NAME=medical_docs
APP__STORAGE__CHROMA_PERSIST_DIRECTORY=data/chroma-d11
APP__PRODUCTION__PRODUCTION_PROFILE=baseline
